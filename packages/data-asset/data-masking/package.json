{
  "name": "@liuhange/dsh-data-masking",
  "description": "数据脱敏插件 — 敏感字段识别+分级脱敏（部分脱敏/完全脱敏/哈希脱敏）",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@liuhange/dsh-data-asset-shared": "^3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "data-masking",
    "sensitive-field",
    "masking-strategy",
    "partial-masking",
    "full-masking",
    "数据脱敏",
    "敏感字段",
    "脱敏策略",
    "部分脱敏",
    "完全脱敏",
    "dsh",
    "typescript",
    "nodejs",
    "automation",
    "audit",
    "compliance",
    "data-governance",
    "data-quality",
    "plugin",
    "open-source",
    "data-management",
    "masking",
    "anonymization",
    "privacy",
    "gdpr",
    "pii",
    "redaction",
    "data-protection"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector/blob/main/PACKAGES.md"
}
