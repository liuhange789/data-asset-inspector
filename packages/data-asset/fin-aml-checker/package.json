{
  "name": "@liuhange/dsh-fin-aml-checker",
  "description": "金融反洗钱合规检查插件 — 检测大额/可疑交易阈值、豁免、时效性，输出反洗钱合规报告",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "config/*.json",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@liuhange/dsh-data-asset-shared": "^3.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "typescript",
    "nodejs",
    "open-source",
    "plugin",
    "automation",
    "audit",
    "compliance",
    "data-governance",
    "data-quality",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "aml",
    "anti-money-laundering",
    "financial-compliance",
    "反洗钱",
    "金融合规",
    "大额交易",
    "可疑交易",
    "交易监控",
    "阈值检测",
    "fintech",
    "financial-audit",
    "kyc",
    "suspicious-transaction",
    "transaction-monitoring",
    "compliance-report",
    "银行",
    "保险",
    "证券",
    "金融监管",
    "risk-control"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector/blob/main/PACKAGES.md"
}
