{
  "name": "@liuhange/dsh-fin-aml-checker",
  "description": "Financial AML compliance plugin per 反洗钱法 & 央行令: large & suspicious transaction threshold detection, exemption filtering, timeliness check, KYC, CFT, regulatory reporting for banking compliance",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git",
    "directory": "packages/data-asset/fin-aml-checker"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "config/*.json",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@liuhange/dsh-data-asset-shared": "^3.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
