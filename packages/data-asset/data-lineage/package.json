{
  "name": "@liuhange/dsh-data-lineage",
  "description": "Data lineage tracking plugin: trace data flow from source to product with hash chaining and Mermaid visualization Also known as @deepseek-ai/dsh-data-lineage.",
  "version": "2.0.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git",
    "directory": "packages/data-asset/data-lineage"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@liuhange/dsh-data-asset-shared": "^2.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "data-lineage",
    "lineage-tracking",
    "mermaid",
    "hash-chaining",
    "lineage-export",
    "数据血缘",
    "血缘追踪",
    "链式追溯",
    "血缘导出"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector#readme",
  "dsh": {
    "bundle": {
      "patch": true
    }
  }
}
