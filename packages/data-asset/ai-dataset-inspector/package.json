{
  "name": "@liuhange/dsh-ai-dataset-inspector",
  "description": "AI训练数据集质检插件 — 检测标注一致性、标签分布、数据泄露，输出质检报告",
  "version": "3.1.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@liuhange/dsh-data-asset-shared": "^3.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "typescript",
    "nodejs",
    "open-source",
    "plugin",
    "automation",
    "audit",
    "compliance",
    "data-governance",
    "data-quality",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "ai-dataset",
    "training-data-quality",
    "annotation-audit",
    "AI数据集",
    "训练数据",
    "标注一致性",
    "标签分布",
    "数据泄露",
    "machine-learning",
    "ml-data",
    "dataset-quality",
    "annotation-quality",
    "label-distribution",
    "data-leakage",
    "ai-quality",
    "training-set",
    "ground-truth",
    "model-training",
    "data-validation",
    "质检报告"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector/blob/main/PACKAGES.md"
}
