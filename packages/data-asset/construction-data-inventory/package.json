{
  "name": "@liuhange/dsh-construction-data-inventory",
  "description": "建筑工程数据资产盘点插件 — 盘点BIM/IFC分类、资产编码，输出资产清单",
  "version": "3.2.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "config/*.json",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@liuhange/dsh-data-asset-shared": "^3.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "typescript",
    "nodejs",
    "open-source",
    "plugin",
    "automation",
    "audit",
    "compliance",
    "data-governance",
    "data-quality",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "bim-data",
    "construction-inventory",
    "ifc-audit",
    "建筑工程",
    "BIM",
    "IFC",
    "资产编码",
    "资产清单",
    "building-data",
    "construction-data",
    "bim-audit",
    "ifc-classification",
    "asset-encoding",
    "building-information-modeling",
    "工程数据",
    "建筑资产",
    "施工数据",
    "构件分类",
    "工程盘点",
    "建设数据"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector/blob/main/PACKAGES.md"
}
