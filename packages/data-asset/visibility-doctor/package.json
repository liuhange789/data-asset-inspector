{
  "name": "@liuhange/dsh-visibility-doctor",
  "description": "dsh 插件曝光度诊断与采用率提升 CLI 工具",
  "version": "1.0.0",
  "license": "MIT",
  "author": "liuhange789",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "visibility-doctor": "bin/visibility-doctor.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/types/adapter-interfaces.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/types/**/*.d.ts",
    "bin/*.js",
    "templates/*.md",
    "config/*.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git",
    "directory": "packages/data-asset/visibility-doctor"
  },
  "homepage": "https://github.com/liuhange789/data-asset-inspector#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "data-asset",
    "visibility-doctor",
    "cli",
    "diagnostics",
    "npm-registry",
    "exposure-boost"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsc"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}