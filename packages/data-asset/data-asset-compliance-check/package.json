{
  "name": "@liuhange/dsh-data-asset-compliance-check",
  "description": "数据资产合规检查插件 — 检查来源合规性、处理合规性、使用合规性",
  "version": "3.1.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@liuhange/dsh-data-asset-shared": "^3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "compliance-check",
    "compliance-audit",
    "source-compliance",
    "processing-compliance",
    "usage-compliance",
    "合规检查",
    "合规审计",
    "来源合规",
    "处理合规",
    "使用合规",
    "dsh",
    "typescript",
    "nodejs",
    "automation",
    "audit",
    "compliance",
    "data-governance",
    "data-quality",
    "plugin",
    "open-source",
    "data-management",
    "regulatory",
    "legal",
    "standard",
    "policy",
    "rule-checking"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector/blob/main/PACKAGES.md"
}
