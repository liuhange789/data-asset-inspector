{
  "name": "@liuhange/dsh-data-cleaning",
  "description": "数据清洗插件 — 去重+格式标准化+异常值处理+缺失值填充",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@liuhange/dsh-data-asset-shared": "^3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "data-cleaning",
    "deduplication",
    "format-standardization",
    "anomaly-detection",
    "数据清洗",
    "去重",
    "格式标准化",
    "异常检测",
    "dsh",
    "typescript",
    "nodejs",
    "automation",
    "audit",
    "compliance",
    "data-governance",
    "data-quality",
    "plugin",
    "open-source",
    "data-management",
    "cleaning",
    "cleansing",
    "normalization",
    "scrubbing",
    "data-hygiene"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector/blob/main/PACKAGES.md"
}
