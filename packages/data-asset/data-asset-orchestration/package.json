{
    "name":  "@liuhange/dsh-data-asset-orchestration",
    "description":  "Data asset orchestration skill: sequential execution of masking, cleaning, inventory, packaging",
    "version": "3.0.0",
    "publishConfig":  {
                          "access":  "public"
                      },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/liuhange789/data-asset-inspector.git",
                       "directory":  "packages/data-asset/data-asset-orchestration"
                   },
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./invariant":  {
                                        "types":  "./lib/types/invariant.d.ts",
                                        "default":  "./lib/invariant.js"
                                    },
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/**/*.js", "lib/types/**/*.d.ts"
              ],
    "license":  "MIT",
    "scripts": {
      "typecheck": "tsc --noEmit",
      "test": "vitest run",
      "build": "tsc"
    },
    "peerDependencies":  {
                             "@deepseek-ai/cordis": "^4.0.0",
                             "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
                             "@deepseek-ai/dsh-skill": "0.1.0-rc.7",
                             "@liuhange/dsh-data-asset-shared":  "^3.0.0"
                         },
    "dsh":  { "bundle":  { "patch": true } }
}
