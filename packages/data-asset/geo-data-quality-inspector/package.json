{
  "name": "@liuhange/dsh-geo-data-quality-inspector",
  "description": "地理空间数据质量检查插件 — 检测高程精度、拓扑一致性，输出加权质量评分",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "config/*.json",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@liuhange/dsh-data-asset-shared": "^3.2.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "typescript",
    "nodejs",
    "open-source",
    "plugin",
    "automation",
    "audit",
    "compliance",
    "data-governance",
    "data-quality",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "geospatial",
    "gis-quality",
    "spatial-data-inspection",
    "地理空间",
    "空间数据",
    "高程精度",
    "拓扑一致性",
    "质量评分",
    "gis",
    "geo-data",
    "spatial-analysis",
    "coordinate-system",
    "elevation-accuracy",
    "topology-check",
    "coverage-check",
    "mapping",
    "cartography",
    "测绘",
    "地理信息",
    "空间质量"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector/blob/main/PACKAGES.md"
}
