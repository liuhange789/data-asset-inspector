{
  "name": "@liuhange/dsh-geo-data-quality-inspector",
  "description": "Geospatial data quality inspection plugin: elevation accuracy, planar accuracy, edge matching, topology, format consistency, logical consistency, attribute precision, grid parameter, quality element scoring, error classification, and review override per GB/T 24356-2023, GB/T 35644-2017, DSM inspection guidelines, ESRI Shapefile spec, RFC 7946",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git",
    "directory": "packages/data-asset/geo-data-quality-inspector"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "config/*.json",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@liuhange/dsh-data-asset-shared": "^3.2.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "geo-data-quality-inspector",
    "地理空间",
    "数据质量",
    "质量巡检",
    "高程精度",
    "平面精度",
    "拓扑检查",
    "接边检查",
    "质量元素",
    "GB/T 24356",
    "DSM",
    "dsh",
    "typescript",
    "nodejs",
    "automation",
    "audit",
    "compliance",
    "plugin",
    "open-source"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector#readme"
}