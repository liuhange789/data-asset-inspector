  },
  "dsh": {
    "bundle": {
      "patch": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "data-circulation",
    "trusted-data-space",
