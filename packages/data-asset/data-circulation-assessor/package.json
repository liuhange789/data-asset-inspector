{
  "name": "@liuhange/dsh-data-circulation-assessor",
  "description": "Data circulation assessor plugin: trusted data space readiness and transaction compliance prediction",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git",
    "directory": "packages/data-asset/data-circulation-assessor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
