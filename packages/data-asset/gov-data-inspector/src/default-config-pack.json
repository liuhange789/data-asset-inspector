  "formatRules": [
    {
      "field": "办理时限",
      "pattern": "^\\d+个工作日$",
      "suggestionTemplate": "办理时限应使用\"X个工作日\"格式，如\"20个工作日\""
    },
    {
      "field": "咨询电话",
      "pattern": "^(\\d{3,4}[-\\s]?)?\\d{7,8}$",
      "suggestionTemplate": "咨询电话应使用\"区号-号码\"格式，如\"010-12345678\""
    },
    {
      "field": "收费标准",
      "requiredKeywords": [
        "不收费",
        "收费依据"
      ],
      "suggestionTemplate": "收费标准应注明\"不收费\"或\"金额+收费依据\""
    },
    {
      "field": "办理地点",
      "requiredKeywords": [
        "街道",
        "路",
        "号",
        "室",
        "楼",
        "层",
        "栋",
        "区",
        "市",
        "县",
        "镇",
        "大道",
        "广场",
        "中心",
        "大厅",
        "巷",
        "街"
      ],
      "fuzzyDescriptors": [
        "线上",
        "线上办理",
        "网上办理",
        "区街镇机构",
        "政务服务中心",
        "行政服务中心",
        "便民服务中心",
        "综合服务大厅",
        "就近办理",
        "任意网点"
      ],
      "suggestionTemplate": "办理地点应包含具体地址信息(街道/路/号等)，不应仅用模糊描述",
      "addressSpecificKeywords": [
        "街道",
        "路",
        "号",
        "室",
        "楼",
        "层",
        "栋",
        "区",
        "市",
        "县",
        "镇",
        "村"
      ]
    },
    {
      "field": "监督电话",
      "pattern": "^(\\d{3,4}[-\\s]?)?\\d{7,8}$",
      "suggestionTemplate": "监督电话应使用\"区号-号码\"格式，如\"010-12345678\""
    },
    {
      "field": "办理时间",
      "requiredKeywords": [
        "工作日",
        "上午",
        "下午",
        "周一至周五",
        "周一",
        "周二",
        "周三",
        "周四",
        "周五",
        "9:00",
        "时段",
        "营业",
        "办公"
      ],
      "matchMode": "any",
      "suggestionTemplate": "办理时间应注明工作日及上下午时段，如\"周一至周五 上午9:00-12:00 下午13:30-17:00\""
    },
    {
      "field": "申请材料",
      "pattern": "^(?!.*其他材料)(?!.*相关材料).*$",
      "suggestionTemplate": "材料名称应明确具体，不应使用兜底性表述"
    },
    {
      "field": "申请材料来源",
      "pattern": "^.+$",
      "suggestionTemplate": "每项申请材料的来源/出具单位必须非空"
    },
    {
      "field": "纸质材料份数",
      "pattern": "^[1-9]\\d*$",
      "suggestionTemplate": "纸质材料份数必须为正整数"
    },
    {
      "field": "联系电话",
      "pattern": "^(\\d{3,4}[-\\s]?)?\\d{7,8}$",
      "suggestionTemplate": "联系电话应使用'区号-号码'格式，如 010-12345678"
    },
    {
      "field": "办理时间",
      "pattern": "【星期[一二三四五六日天].*】",
      "matchMode": "any",
      "suggestionTemplate": "办理时间应使用'【星期X至星期Y：上午HH:MM-HH:MM】'格式"
    }
  ],
