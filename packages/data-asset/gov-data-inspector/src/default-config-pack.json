    {
      "name": "行政许可事项办事指南编写规范",
      "docNumber": "国标（现行）",
      "coreRequirement": "规范行政许可事项办事指南的编写要求，明确事项名称、实施主体、办理条件、申请材料、办理流程、办理时限等核心要素的编写标准与准确完整要求"
    },
    {
      "name": "进一步深化互联网+政务服务推进一网一门一次改革实施方案",
      "docNumber": "国办发〔2018〕45号",
      "coreRequirement": "规范政务服务事项办理流程、办理条件、申请材料等核心要素，推进一网通办，明确办事指南信息完整准确要求"
    },
    {
      "name": "政府网站发展指引",
      "docNumber": "国办发〔2017〕47号",
      "coreRequirement": "要求政府网站规范政务公开与办事服务，办事指南信息应完整准确、及时更新"
    },
    {
      "name": "国家政务服务平台事项库",
      "docNumber": "zwfw.www.gov.cn",
      "coreRequirement": "国家政务服务平台统一事项库提供全国政务服务事项的法定办理时限、标准申请材料清单与标准办理条件等权威基准数据"
    },
    {
      "name": "广东省政务服务事项管理系统",
      "docNumber": "www.gdzwfw.gov.cn",
      "coreRequirement": "广东省政务服务事项管理系统提供广东省地方性事项的实施标准与办理规范等权威基准数据"
    }
