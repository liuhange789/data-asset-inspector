    {
      "name": "政府网站发展指引",
      "docNumber": "国办发〔2017〕47号",
      "coreRequirement": "要求政府网站规范政务公开与办事服务，办事指南信息应完整准确、及时更新"
    },
    {
      "name": "国家政务服务平台事项库",
      "docNumber": "zwfw.www.gov.cn",
      "coreRequirement": "国家政务服务平台统一事项库提供全国政务服务事项的法定办理时限、标准申请材料清单与标准办理条件等权威基准数据"
    },
    {
      "name": "广东省政务服务事项管理系统",
      "docNumber": "www.gdzwfw.gov.cn",
      "coreRequirement": "广东省政务服务事项管理系统提供广东省地方性事项的实施标准与办理规范等权威基准数据"
    }
