  "logicErrorRules": [
    {
      "ruleId": "LOG_SITE_INSPECTION_001",
      "triggerFields": [
        "办理流程",
        "办理时限"
      ],
      "condition": "流程含'现场勘查'且时限<5工作日",
      "threshold": 5,
      "suggestionTemplate": "办理流程含\"现场勘查\"环节，办理时限应不少于5个工作日，当前时限过短",
      "standardClause": "国办发〔2017〕47号 第5.2条",
      "triggerKeywords": [
        "现场勘查"
      ]
    },
    {
      "ruleId": "LOG_INSTANT_HANDLE_001",
      "triggerFields": [
        "办理流程",
        "办理时限"
      ],
      "condition": "流程含'当场办理'且时限为长时限(工作日单位且数值>1)",
      "threshold": 1,
      "suggestionTemplate": "办理流程含\"当场办理\"环节，办理时限应为当场办结或1个工作日内，当前时限过长",
      "standardClause": "国办发〔2017〕47号 第5.3条",
      "triggerKeywords": [
        "当场办理"
      ]
    },
    {
      "ruleId": "LOG_CONDITION_PROXY_001",
      "triggerFields": [
        "办理条件",
        "办理流程"
      ],
      "condition": "条件要求'本人到场'但流程允许代办",
      "suggestionTemplate": "办理条件要求\"本人到场\"但办理流程允许代办，两者存在矛盾，建议统一",
      "standardClause": "国办发〔2017〕47号 第5.4条",
      "triggerKeywords": [
        "本人到场",
        "本人办理",
        "代办",
        "委托办理"
      ]
    },
    {
      "ruleId": "LOG_MATERIAL_CONDITION_001",
      "triggerFields": [
        "申请材料",
        "办理条件"
      ],
      "condition": "条件要求的证明材料未列入材料清单",
