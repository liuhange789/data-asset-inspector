{
  "name": "@liuhange/dsh-gov-data-inspector",
  "description": "检测政务办事指南的漏项、语义、逻辑、格式错误，输出合规审计报告",
  "version": "3.5.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git",
    "directory": "packages/data-asset/gov-data-inspector"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/**/*.json",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@liuhange/dsh-data-asset-shared": "^3.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@liuhange/gov-config-gd": "^2026.1.0",
    "@liuhange/gov-config-zj": "^2026.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "gov-data",
    "government-compliance",
    "data-inspection",
    "dsh-plugin"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector#readme"
}
