{
  "name": "@liuhange/dsh-data-asset-valuation",
  "description": "Data asset valuation plugin: cost-based (replacement cost - depreciation) + income-based (DCF) dual model Also known as @deepseek-ai/dsh-data-asset-valuation.",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git",
    "directory": "packages/data-asset/data-asset-valuation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@liuhange/dsh-data-asset-shared": "^3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "asset-valuation",
    "cost-based",
    "income-based",
    "dcf",
    "depreciation",
    "资产估值",
    "成本法",
    "收益法",
    "折现现金流",
    "贬值折旧"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector#readme"
}
