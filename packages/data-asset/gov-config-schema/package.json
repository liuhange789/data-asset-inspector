{
  "name": "@liuhange/gov-config-schema",
  "version": "2026.1.3",
  "description": "政务数据巡检配置包 JSON Schema — 供配置包维护者离线校验配置包内容，提供 Schema 加载与校验运行时",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "require": "./config-pack-schema.json",
      "default": "./lib/index.js"
    },
    "./config-pack-schema.json": "./config-pack-schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "config-pack-schema.json",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git"
  },
  "keywords": [
    "gov-data",
    "config-pack",
    "json-schema",
    "schema",
    "dsh-plugin",
    "validation",
    "data-inspection",
    "gbt-47949",
    "compliance",
    "data-governance",
    "typescript",
    "npm",
    "deepseek-harness",
    "dsh",
    "data-asset",
    "government-data",
    "public-data",
    "plugin",
    "nodejs",
    "data-quality",
    "data-management",
    "audit",
    "automation",
    "open-source",
    "config-schema",
    "specification",
    "registration",
    "valuation"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "homepage": "https://github.com/liuhange789/data-asset-inspector/blob/main/PACKAGES.md"
}
