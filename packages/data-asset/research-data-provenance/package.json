{
  "name": "@liuhange/dsh-research-data-provenance",
  "description": "科研数据溯源审计插件 — 审计血缘完整性、可复现性、FAIR原则，输出溯源报告",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/data-asset-inspector.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "config/**/*.json",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@liuhange/dsh-data-asset-shared": "^3.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "typescript",
    "nodejs",
    "open-source",
    "plugin",
    "automation",
    "audit",
    "compliance",
    "data-governance",
    "data-quality",
    "data-asset",
    "data-asset-inspector",
    "shujintong",
    "数据资产",
    "research-data",
    "data-provenance",
    "fair-principles",
    "科研数据",
    "数据溯源",
    "血缘完整性",
    "可复现性",
    "FAIR原则",
    "scientific-data",
    "reproducibility",
    "lineage-tracking",
    "research-integrity",
    "data-traceability",
    "provenance-audit",
    "open-science",
    "科研诚信",
    "学术数据",
    "实验数据",
    "溯源审计",
    "可追溯"
  ],
  "homepage": "https://github.com/liuhange789/data-asset-inspector/blob/main/PACKAGES.md"
}
