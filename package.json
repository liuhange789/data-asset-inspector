{
  "name": "@liuhange/dsh-root",
  "version": "3.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --filter './packages/data-asset/*' run typecheck",
    "test": "vitest run",
    "build": "pnpm -r --filter './packages/data-asset/*' run build"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0",
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.1",
    "@deepseek-ai/dsh-code-runtime": "0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.0.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.0.1-rc.1",
    "@deepseek-ai/dsh-brand": "0.0.1-rc.1",
    "@deepseek-ai/dsh-attachment": "0.0.1-rc.1",
    "@liuhange/dsh-data-asset-shared": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/schemastery": "^3.18.0",
      "@deepseek-ai/cordis": "^4.0.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@deepseek-ai/schemastery": "^3.18.0",
        "@deepseek-ai/cordis": "^4.0.0"
      }
    }
  }
}